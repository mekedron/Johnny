# Copy to .env and fill in. `docker compose up` reads this file automatically.

# === Postgres ===
POSTGRES_USER=johnny
POSTGRES_PASSWORD=johnny
POSTGRES_DB=johnny
# SQLAlchemy URL used by the api and worker services (in-compose DNS name).
DATABASE_URL=postgresql+psycopg://johnny:johnny@postgres:5432/johnny

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Encryption (US-005, US-018) ===
# Generate (stdlib only, no extra installs needed):
#   python3 -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Or with openssl:
#   openssl rand 32 | base64 | tr '+/' '-_' | tr -d '\n'; echo
# Required for encrypting Google tokens and provider credentials at rest.
FERNET_KEY=

# === Google OAuth (US-005) ===
# Desktop OAuth client credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Loopback redirect URI registered on the OAuth client. Default works
# for `docker compose up`; override if you front the API on another host.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# === Provider API keys (US-011..US-018) ===
# Leave blank for providers you will not enable; per-provider records in the
# UI override these for runtime use, but the env vars seed initial values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# === Local TTS (US-017) ===
# Piper voice model directory; the meet-worker container mounts the
# `piper_models` named volume here. Override only if you keep models on a
# host path (e.g. for development).
JOHNNY_PIPER_MODEL_DIR=/var/lib/johnny/piper-models
# Path to the piper binary inside the meet-worker image. Default `piper`
# resolves via PATH; override to point at a vendored build.
JOHNNY_PIPER_BINARY=piper

# === Local STT (US-013) ===
# faster-whisper model cache directory; the meet-worker container mounts
# the `whisper_models` named volume here so downloaded CTranslate2 model
# files survive restarts. Override only if you keep models on a host
# path (e.g. for development).
JOHNNY_WHISPER_MODEL_DIR=/var/lib/johnny/whisper-models

# === Captured reply audio (Johnny-od1) ===
# Every utterance Johnny speaks is saved as a WAV under
# <JOHNNY_SESSION_AUDIO_DIR>/<bot_session_id>/ for replay on the History page
# and in the live session view. The dir is a host bind mount
# (~/.johnny/session-audio by default, created by run.sh) shared by api,
# worker, agent-worker, and each spawned meet-worker. Unset/empty disables
# capture. JOHNNY_MEET_WORKER_SESSION_AUDIO_VOLUME is the host-side path the
# launcher mounts into per-session meet-worker containers; set it to `none`
# to skip that mount (disables capture for unified Meet sessions only).
JOHNNY_SESSION_AUDIO_DIR=/var/lib/johnny/session-audio
JOHNNY_MEET_WORKER_SESSION_AUDIO_VOLUME=

# === Host sidecars (Johnny-1ge.6) ===
# `./run.sh` starts every available host sidecar (Parakeet STT / Piper / Kokoro
# TTS) after the Docker stack is up, so a saved sidecar-runtime works without a
# separate manual launch; `./stop.sh` stops them before tearing the stack down.
# Skip specific sidecars with a comma-separated list of <provider>-<backend>
# keys. Recognised: parakeet-mlx, parakeet-coreml, piper-http, kitten-http,
# kokoro-mlx, kokoro-http. Unknown keys are ignored with a warning. Empty =
# start everything whose toolchain (uv / swift) is installed.
JOHNNY_DISABLED_SIDECARS=
# Where each launcher writes its <provider>-<backend>-sidecar.{log,pid} files.
# Defaults to .validation/ in the repo root.
JOHNNY_SIDECAR_LOG_DIR=
# Per-sidecar overrides follow the <UPPER_PROVIDER>_<UPPER_BACKEND>_{PORT,HOST,
# MODEL} convention, e.g. PARAKEET_MLX_PORT=8765, PIPER_HTTP_PORT=8775,
# KOKORO_MLX_PORT=8772. See ./scripts/start-sidecars.sh --help and each
# ./scripts/start-<provider>-sidecar.sh --help for the full list.

# === Local LLM via Ollama (Johnny-trt.8) ===
# NOT a Johnny/compose variable — set it on the HOST's Ollama server. Johnny
# pings the LLM at every session start (provider prewarm) so the model is
# loaded before the first turn, but Ollama's default keep_alive (5m) evicts
# the model again after idle, re-paying 1-5 s of GGUF load mid-session or
# between sessions. Keep it resident:
#   launchctl setenv OLLAMA_KEEP_ALIVE 24h   # macOS app; restart Ollama after
#   OLLAMA_KEEP_ALIVE=24h ollama serve       # manually-run server
# See docs/LATENCY.md ("Provider prewarm at session start").

# === Provider seed (Johnny-d3e) ===
# Auto-import provider credentials from a JSON file on stack startup so
# the user can commit a configuration once and replay it after a clean
# reset. The shape of the file matches the export endpoint (Johnny-k3z);
# see backend/app/services/providers_seed.py for the schema.
# Path inside the api container. The default matches the bind-mount
# `./config:/config:ro` in docker-compose.yml.
JOHNNY_PROVIDERS_FILE=/config/providers.json
# Reconciliation strategy when a file row already exists in the DB:
#   insert-only — add missing rows, leave UI edits alone (default, safest)
#   overwrite   — force-sync from file (re-encrypt credentials, replace
#                 options, sync is_active). Use after a deliberate edit
#                 of the JSON file.
#   disabled    — skip the seeder entirely.
JOHNNY_PROVIDERS_SEED_MODE=insert-only

# === Calendar polling (US-007) ===
# How often the worker re-syncs Google Calendar for accounts that have at
# least one meeting_config attached, in seconds. Default 5 minutes.
# Lower values use more Google API quota; higher values delay detection
# of rescheduled meetings.
JOHNNY_CALENDAR_POLL_INTERVAL_SECONDS=300

# === Voice transport (US-025) ===
# Which transport the voice pipeline uses. Default `local` wraps the
# meet-worker's PulseAudio bridge (PulseAudio inside the meet-worker
# container). Set to `livekit` to run the pipeline inside a LiveKit
# room instead — used with stronger realtime infra. The LiveKit Python
# SDK (`pip install livekit`) is only required when this flag is set.
JOHNNY_TRANSPORT=local
# LiveKit room connection details. Leave blank to use the in-compose
# self-hosted server (Johnny-6wx): docker-compose.yml defaults LIVEKIT_URL
# to `ws://livekit:7880`, reachable container-to-container only. A token is
# minted at runtime from LIVEKIT_API_KEY/SECRET below, so LIVEKIT_TOKEN is
# only needed when pointing at an external LiveKit you don't control.
LIVEKIT_URL=
LIVEKIT_TOKEN=
LIVEKIT_ROOM=
# Identity the bot publishes under in the LiveKit room. Default `johnny-bot`.
LIVEKIT_IDENTITY=johnny-bot

# === Self-hosted LiveKit server (Johnny-6wx) ===
# API key/secret for the in-compose `livekit` SFU service. The server is
# started with these as its only credential (LIVEKIT_KEYS), and the
# api/worker mint room tokens with the same pair — keep them identical.
# The server is INTERNAL ONLY (no host port published), so these dev
# defaults are safe for local use; CHANGE THE SECRET before exposing the
# port anywhere. The secret MUST be at least 32 characters or the LiveKit
# server refuses to start.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=johnny-livekit-dev-secret-change-me-0123456789

# === Voice orchestrator (Johnny-wz5; default flipped in Johnny-n22) ===
# Per-session engine selector for the LiveKit-Agents migration (epic Johnny-7g5).
#   agentsession  — (default) the API dispatches a LiveKit agent worker per
#                   session AND each meet-worker runs as a pure audio bridge into
#                   that session's room (the STT→LLM→TTS pipeline runs in the
#                   agent worker). Requires the self-hosted LiveKit server above.
#   legacy        — break-glass opt-out (Johnny-9xt): the meet-worker joins the
#                   Meet and runs a diagnostic audio-capture pump only. No
#                   in-worker pipeline exists — the split orchestrator was
#                   retired in Johnny-n22 and the unified (S2S) pipeline was
#                   removed in Johnny-trt.43.
# Flipping to `legacy` (and back) needs no data migration.
JOHNNY_ORCHESTRATOR=agentsession

# === Container launcher (US-030) ===
# Set to "true" to wire the Docker SDK-backed launcher into the API and
# worker. When unset, both processes use the no-op launcher: scheduler
# decisions still happen, but meet-worker containers are NOT actually
# spawned. Production deployments and `docker compose up` should set this.
JOHNNY_USE_DOCKER_LAUNCHER=
# Image tag the launcher pulls when spawning a meet-worker. Matches the
# `image:` field on the `meet-worker` service in docker-compose.yml.
JOHNNY_MEET_WORKER_IMAGE=johnny-meet-worker:latest
# How often the worker polls active meet-worker containers to detect
# clean exits / crashes and persist logs + status. Default 30 seconds.
JOHNNY_CONTAINER_MONITOR_INTERVAL_SECONDS=30
# How often the worker prunes stopped meet-worker containers older than
# the retention window. Default 1 hour.
JOHNNY_CONTAINER_PRUNE_INTERVAL_SECONDS=3600
# Retention window for stopped containers, in seconds. Default 24 hours.
JOHNNY_CONTAINER_PRUNE_AGE_SECONDS=86400

# === Skills sandbox (Johnny-trt.35) ===
# The skills-sandbox compose service is the execution boundary for all
# skill / CLI tool work (see sandbox/README.md). Its exec API is internal
# to the compose network — no published ports. All knobs below have sane
# defaults baked into docker-compose.yml; override only when needed.
#
# Where api/worker reach the exec API, and where skill packages
# (<name>/SKILL.md, mounted from ~/.johnny/skills) appear in-container.
JOHNNY_SKILLS_SANDBOX_URL=http://skills-sandbox:8088
JOHNNY_SKILLS_DIR=/skills
# Internal tools (Johnny-trt.57): where the agent process reaches Johnny's
# own api for first-party voice actions (meeting.leave / session.end) —
# the same endpoints the UI buttons call.
JOHNNY_API_BASE_URL=http://api:8000
# Compose resource limits for the sandbox container.
JOHNNY_SANDBOX_CPUS=2
JOHNNY_SANDBOX_MEM_LIMIT=1g
# Per-exec caps enforced by the exec daemon: default/maximum command
# timeout (seconds; requests above the max are rejected with 400) and
# per-stream stdout/stderr + request-body byte caps (output beyond the
# cap is dropped and flagged `truncated`; oversized bodies get 413).
SANDBOX_EXEC_TIMEOUT_DEFAULT_S=30
SANDBOX_EXEC_TIMEOUT_MAX_S=300
SANDBOX_EXEC_OUTPUT_CAP_BYTES=262144
SANDBOX_EXEC_BODY_CAP_BYTES=262144
# Password for gog's file-based keyring (set once after running gog auth keyring file).
# Used by gog for calendar/gmail skills. Keep the same value across all gog invocations.
GOG_KEYRING_PASSWORD=

# === Per-workspace sandbox containers (Johnny-wks.2) ===
# Every NON-default workspace gets its own lazily-launched container of the
# skills-sandbox image (johnny-workspace-<id>, label johnny.workspace-id),
# started on first dispatch/claim, stopped after the idle TTL, and restarted
# transparently with state intact in its named volume
# (johnny-workspace-<id>-home — never auto-deleted; remove via the workspace
# delete API's ?remove_volume=true). The default workspace keeps the
# always-on skills-sandbox service above. Defaults are baked into
# docker-compose.yml; override only when needed.
JOHNNY_WORKSPACE_SANDBOX_IMAGE=johnny-skills-sandbox:latest
JOHNNY_WORKSPACE_SANDBOX_NETWORK=johnny_default
# HOST path (or named volume) mounted read-only at /skills in each
# workspace container — keep in sync with the skills-sandbox mount.
JOHNNY_WORKSPACE_SKILLS_VOLUME=${HOME}/.johnny/skills
JOHNNY_WORKSPACE_IDLE_TTL_SECONDS=1800
JOHNNY_WORKSPACE_SWEEP_INTERVAL_SECONDS=60
JOHNNY_WORKSPACE_STARTUP_TIMEOUT_SECONDS=20

# === Delegated-task executor pass (Johnny-trt.24) ===
# The worker claims queued agent_tasks rows (delegate verdicts) and runs
# them via the skills-sandbox: woken instantly over johnny.tasks.wake,
# polling as fallback. All defaults are baked in; override only when needed.
# Set JOHNNY_TASK_EXECUTOR_ENABLED=false to park the pass (rows stay queued).
JOHNNY_TASK_EXECUTOR_ENABLED=true
JOHNNY_TASK_POLL_INTERVAL_SECONDS=5
JOHNNY_TASK_CONCURRENCY=4
# Stale-`running` requeue TTL + the attempts cap that settles a repeatedly
# crashed task `failed`; the per-task execution timeout stays below the TTL.
JOHNNY_TASK_RUNNING_TTL_SECONDS=300
JOHNNY_TASK_MAX_ATTEMPTS=3
JOHNNY_TASK_EXEC_TIMEOUT_SECONDS=240
