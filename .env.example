# Copy to .env and fill in. `docker compose up` reads this file automatically.

# === Postgres ===
POSTGRES_USER=johnny
POSTGRES_PASSWORD=johnny
POSTGRES_DB=johnny
# SQLAlchemy URL used by the api and worker services (in-compose DNS name).
DATABASE_URL=postgresql+psycopg://johnny:johnny@postgres:5432/johnny

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Encryption (US-005, US-018) ===
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required for encrypting Google tokens and provider credentials at rest.
FERNET_KEY=

# === Google OAuth (US-005) ===
# Desktop OAuth client credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Loopback redirect URI registered on the OAuth client. Default works
# for `docker compose up`; override if you front the API on another host.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# === Provider API keys (US-011..US-018) ===
# Leave blank for providers you will not enable; per-provider records in the
# UI override these for runtime use, but the env vars seed initial values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# === Local TTS (US-017) ===
# Piper voice model directory; the meet-worker container mounts the
# `piper_models` named volume here. Override only if you keep models on a
# host path (e.g. for development).
JOHNNY_PIPER_MODEL_DIR=/var/lib/johnny/piper-models
# Path to the piper binary inside the meet-worker image. Default `piper`
# resolves via PATH; override to point at a vendored build.
JOHNNY_PIPER_BINARY=piper

# === Local STT (US-013) ===
# faster-whisper model cache directory; the meet-worker container mounts
# the `whisper_models` named volume here so downloaded CTranslate2 model
# files survive restarts. Override only if you keep models on a host
# path (e.g. for development).
JOHNNY_WHISPER_MODEL_DIR=/var/lib/johnny/whisper-models

# === Calendar polling (US-007) ===
# How often the worker re-syncs Google Calendar for accounts that have at
# least one meeting_config attached, in seconds. Default 5 minutes.
# Lower values use more Google API quota; higher values delay detection
# of rescheduled meetings.
JOHNNY_CALENDAR_POLL_INTERVAL_SECONDS=300

# === Voice transport (US-025) ===
# Which transport the voice pipeline uses. Default `local` wraps the
# meet-worker's PulseAudio bridge (PulseAudio inside the meet-worker
# container). Set to `livekit` to run the pipeline inside a LiveKit
# room instead — used with stronger realtime infra. The LiveKit Python
# SDK (`pip install livekit`) is only required when this flag is set.
JOHNNY_TRANSPORT=local
# LiveKit room connection details. Required when JOHNNY_TRANSPORT=livekit.
LIVEKIT_URL=
LIVEKIT_TOKEN=
LIVEKIT_ROOM=
# Identity the bot publishes under in the LiveKit room. Default `johnny-bot`.
LIVEKIT_IDENTITY=johnny-bot

# === Container launcher (US-030) ===
# Set to "true" to wire the Docker SDK-backed launcher into the API and
# worker. When unset, both processes use the no-op launcher: scheduler
# decisions still happen, but meet-worker containers are NOT actually
# spawned. Production deployments and `docker compose up` should set this.
JOHNNY_USE_DOCKER_LAUNCHER=
# Image tag the launcher pulls when spawning a meet-worker. Matches the
# `image:` field on the `meet-worker` service in docker-compose.yml.
JOHNNY_MEET_WORKER_IMAGE=johnny-meet-worker:latest
# How often the worker polls active meet-worker containers to detect
# clean exits / crashes and persist logs + status. Default 30 seconds.
JOHNNY_CONTAINER_MONITOR_INTERVAL_SECONDS=30
# How often the worker prunes stopped meet-worker containers older than
# the retention window. Default 1 hour.
JOHNNY_CONTAINER_PRUNE_INTERVAL_SECONDS=3600
# Retention window for stopped containers, in seconds. Default 24 hours.
JOHNNY_CONTAINER_PRUNE_AGE_SECONDS=86400
