
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# bv (beads viewer) local config and caches
.bv/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Node / SvelteKit
node_modules/
.svelte-kit/
frontend/build/
frontend/.vercel/
frontend/.netlify/

# Editors / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Env
.env
.env.local
.env.*.local

client_secret*.json

# Browser-validation artifacts — chrome-devtools MCP screenshots, snapshots,
# console dumps. Local-only; never committed. See AGENTS.md → "Where to save
# browser-validation artifacts" for the convention. The canonical path is
# .validation/, but the legacy .validation-* prefix is also caught for older
# scratch dirs.
.validation/
.validation-*/

# Chrome profile used by the chrome-devtools MCP server (./scripts/start-chrome.sh
# attaches Chrome on 127.0.0.1:9222 to this profile). Pure runtime cache /
# cookies / extension state — must never be committed; was previously the
# largest source of repo bloat.
.chrome-profile/

# ralph-tui runtime artifacts — agent iteration logs and per-iteration
# screenshots. Scratch data, not source. The .ralph-tui/config.toml /
# progress.md / live/ files are intentionally tracked when present.
.ralph-tui/iterations/
.ralph-tui/screenshots/
.ralph-tui/reports/

# impeccable design-tool live state — local scratch.
.impeccable/

# Pre-rewrite backup of .git/ created before any git-filter-repo run. Always
# generated locally as a rollback parachute; an earlier session accidentally
# committed it via `git add -A` (176 MB), so the pattern is ignored
# defensively. Delete the directory manually once the rewrite is confirmed.
.git-backup-pre-rewrite/
.git-backup-*/

# Swift Package Manager build artifacts. The CoreML Parakeet sidecar at
# sidecars/parakeet-coreml/ produces a .build/ tree on `swift build` that
# can grow to thousands of derived files; only Package.swift /
# Package.resolved / Sources/ get committed. .swiftpm/ holds editor-local
# IDE state and per-machine dependency snapshots.
.build/
.swiftpm/
