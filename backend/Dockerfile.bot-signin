# Bot sign-in container image (Johnny-105, Johnny-hvg). One container per
# sign-in session is spawned by the API process (see
# ``app.services.bot_signin_launcher``); inside, the entrypoint brings
# up Xvfb + x11vnc + websockify and the supervisor at
# ``johnny.bot_signin.supervisor`` drives a signed-in Google session.
#
# Johnny-hvg: the interactive login now runs in a real Chrome/Chromium
# launched as a plain subprocess (no --enable-automation, no webdriver),
# NOT driven by Playwright — Google's sign-in flags the automated browser.
# Branded Google Chrome is used on amd64 (extra hardening); on arm64 we use
# the headed Chromium the base image bundles. Playwright is still installed,
# but only to attach over a passive CDP port AFTER login to dump the
# storage_state.
#
# Build with: ``docker compose --profile bot-signin build bot-signin``.
# The main Compose stack only *builds* the image; the launcher spawns
# instances on demand via the Docker SDK.

FROM mcr.microsoft.com/playwright/python:v1.49.0-noble

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/workspace \
    DISPLAY=:99

# System A/V environment:
#   * xvfb           — virtual X server so Chromium can render headed
#   * x11vnc         — VNC over TCP for a headed display
#   * x11-utils      — xdpyinfo, used by the entrypoint readiness check
#   * websockify     — TCP-over-WebSocket bridge for noVNC
#   * dbus-x11       — Chromium needs a session DBus to start cleanly
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
        x11vnc \
        x11-utils \
        websockify \
        dbus-x11 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Pinned Playwright matches the api/meet-worker images so a storage_state
# written here is interoperable. The base image already ships Chromium
# (used only for the post-login CDP attach, never for the login itself).
RUN pip install --no-cache-dir playwright==1.49.0

# Branded Google Chrome for the interactive login — WHERE THE PLATFORM HAS IT.
# Google ships Chrome for Linux on amd64 only; on arm64 (e.g. Apple-Silicon
# Docker) there is no Linux Chrome, so we fall back to the headed Chromium the
# Playwright base image already bundles (at /ms-playwright/chromium-*). Either
# way the supervisor launches the binary as a plain, NON-automated subprocess
# (the actual fix); branded Chrome is just extra hardening where available.
# ``playwright install chrome`` installs google-chrome-stable at
# /opt/google/chrome/chrome (symlinked /usr/bin/google-chrome).
RUN if [ "$(dpkg --print-architecture)" = "amd64" ]; then \
        playwright install --with-deps chrome \
            || echo "[bot-signin] branded Chrome install failed; falling back to bundled Chromium"; \
    else \
        echo "[bot-signin] arch=$(dpkg --print-architecture): no Linux branded Chrome; using bundled Chromium"; \
    fi

# Just enough of the codebase for the supervisor: the bot_signin module
# itself, plus ``johnny.tools.seed_auth_state`` which the supervisor
# reuses for the signed-in URL template and the wait_for_signin loop.
COPY johnny/__init__.py ./johnny/__init__.py
COPY johnny/tools ./johnny/tools
COPY johnny/bot_signin ./johnny/bot_signin

COPY bot-signin-entrypoint.sh /usr/local/bin/bot-signin-entrypoint.sh
RUN chmod +x /usr/local/bin/bot-signin-entrypoint.sh

EXPOSE 6080

ENTRYPOINT ["/usr/local/bin/bot-signin-entrypoint.sh"]
CMD ["python", "-m", "johnny.bot_signin.supervisor"]
