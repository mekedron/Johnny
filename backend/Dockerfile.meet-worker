# Meet-worker base image: Playwright + Chromium running under Xvfb with
# PulseAudio providing a virtual sink (browser playback) and virtual
# source (browser microphone). One container is spawned per active
# Google Meet session by the scheduler (US-029/US-030); the main Compose
# stack only *builds* the image so it's available when the spawner
# needs it.

FROM mcr.microsoft.com/playwright/python:v1.49.0-noble

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/workspace \
    DISPLAY=:99 \
    JOHNNY_SINK_NAME=johnny_speaker \
    JOHNNY_SOURCE_NAME=johnny_mic \
    XDG_RUNTIME_DIR=/tmp/runtime-johnny

# System A/V environment:
#   * xvfb           — virtual X server so Chromium can render headed
#   * x11-utils      — xdpyinfo, used by the entrypoint readiness check
#   * pulseaudio     — userspace audio daemon
#   * pulseaudio-utils — pactl, for module loading and selfcheck
#   * dbus-x11       — Chromium needs a session DBus to start cleanly
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
        x11-utils \
        pulseaudio \
        pulseaudio-utils \
        dbus-x11 \
        scrot \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Runtime deps the voice pipeline needs at import time. The pipeline talks
# to Redis pub/sub for live event fanout (US-031 subscriber); httpx is the
# HTTP client used by the cloud TTS adapters (US-016); websockets is used
# by the cloud STT adapters (US-012, Deepgram + OpenAI Realtime);
# faster-whisper is the local STT backend (US-013, lazy-imported by the
# adapter); piper-tts ships the `piper` CLI used by the local TTS adapter
# (US-016, subprocess invocation). FastAPI and SQLAlchemy are still
# deliberately absent — the pipeline depends only on the pure-Python
# provider ABCs in `app/providers/base.py`.
RUN pip install --no-cache-dir \
        playwright==1.49.0 \
        redis==8.0.0 \
        httpx==0.28.1 \
        websockets==14.1 \
        requests==2.32.3 \
        faster-whisper==1.0.3 \
        piper-tts==1.4.2

# Optional: NVIDIA NeMo for the Parakeet STT adapter (Johnny-stt.1).
# Heavy (~2.5 GB CPU torch + NeMo deps) so it's gated behind a build
# arg — defaults to on so real sessions that pick Parakeet actually
# transcribe; set INSTALL_PARAKEET=0 to skip and keep the meet-worker
# image lean if you only use faster-whisper / cloud STT. CPU-only
# torch is baked in via the PyTorch CPU index; a CUDA variant is
# tracked as a follow-up under the Johnny-stt epic. Conditional sits
# before the `johnny` COPY so source edits don't bust the cache.
ARG INSTALL_PARAKEET=1
# Arch-branched torch source — see backend/Dockerfile for the rationale.
# Briefly: the PyTorch CPU index only ships linux_x86_64; on arm64 we
# let NeMo pull torch transitively from PyPI (aarch64 wheels are CPU-
# only by definition there).
ARG TARGETARCH
RUN set -e; \
    if [ "$INSTALL_PARAKEET" = "1" ]; then \
        apt-get update; \
        apt-get install -y --no-install-recommends libsndfile1; \
        rm -rf /var/lib/apt/lists/*; \
        case "$TARGETARCH" in \
            amd64) \
                pip install --no-cache-dir \
                    --index-url https://download.pytorch.org/whl/cpu \
                    --extra-index-url https://pypi.org/simple \
                    torch torchaudio \
                ;; \
        esac; \
        pip install --no-cache-dir \
            "nemo_toolkit[asr]>=2.5.0" \
            "tokenizers<=0.23.0"; \
    fi
# Tokenizers pin: nemo_toolkit[asr] resolves transformers ~=4.57.0
# (requires tokenizers <=0.23.0), but the earlier faster-whisper
# install above pinned tokenizers==0.23.1 first. Without re-pinning
# here, the env ends up inconsistent and `import nemo.collections.asr`
# fails at module load with a transformers version-check ImportError —
# same root cause as in backend/Dockerfile.

# The `johnny` package owns the meet-worker runtime (selfcheck, audio
# bridge, voice pipeline). The pipeline imports the provider ABCs from
# `app.providers.base` (no SQLAlchemy involved); we ship just the
# providers subpackage and the empty `app/__init__.py` so Python sees
# `app` as a package. `app/providers/loader.py` ships too but is only
# imported by code that has SQLAlchemy on PYTHONPATH — meet-worker never
# does, so it stays inert here.
COPY app/__init__.py ./app/__init__.py
COPY app/providers ./app/providers
COPY johnny ./johnny

COPY meet-worker-entrypoint.sh /usr/local/bin/meet-worker-entrypoint.sh
RUN chmod +x /usr/local/bin/meet-worker-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/meet-worker-entrypoint.sh"]
# Boot the meet-worker bootstrap: structured logging, selfcheck, Google
# sign-in via storage_state, Playwright join, idle in-meeting until the
# parent container stops us. The selfcheck-only CMD that used to live
# here is the root cause of Johnny-ckz.1 (bot never actually joined the
# meeting because nothing called join_meeting()).
CMD ["python", "-m", "johnny.meet_worker"]
