# Meet-worker base image: Playwright + Chromium running under Xvfb with
# PulseAudio providing a virtual sink (browser playback) and virtual
# source (browser microphone). One container is spawned per active
# Google Meet session by the scheduler (US-029/US-030); the main Compose
# stack only *builds* the image so it's available when the spawner
# needs it.

FROM mcr.microsoft.com/playwright/python:v1.49.0-noble

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/workspace \
    DISPLAY=:99 \
    JOHNNY_SINK_NAME=johnny_speaker \
    JOHNNY_SOURCE_NAME=johnny_mic \
    XDG_RUNTIME_DIR=/tmp/runtime-johnny

# System A/V environment:
#   * xvfb           — virtual X server so Chromium can render headed
#   * x11-utils      — xdpyinfo, used by the entrypoint readiness check
#   * pulseaudio     — userspace audio daemon
#   * pulseaudio-utils — pactl, for module loading and selfcheck
#   * dbus-x11       — Chromium needs a session DBus to start cleanly
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
        x11-utils \
        pulseaudio \
        pulseaudio-utils \
        dbus-x11 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Runtime deps the voice pipeline needs at import time. The pipeline talks
# to Redis pub/sub for live event fanout (US-031 subscriber); httpx is the
# HTTP client used by the cloud TTS adapters (US-016); faster-whisper is
# the local STT backend (US-013, lazy-imported by the adapter). FastAPI
# and SQLAlchemy are still deliberately absent — the pipeline depends
# only on the pure-Python provider ABCs in `app/providers/base.py`.
RUN pip install --no-cache-dir redis==8.0.0 httpx==0.28.1 faster-whisper==1.0.3

# The `johnny` package owns the meet-worker runtime (selfcheck, audio
# bridge, voice pipeline). The pipeline imports the provider ABCs from
# `app.providers.base` (no SQLAlchemy involved); we ship just the
# providers subpackage and the empty `app/__init__.py` so Python sees
# `app` as a package. `app/providers/loader.py` ships too but is only
# imported by code that has SQLAlchemy on PYTHONPATH — meet-worker never
# does, so it stays inert here.
COPY app/__init__.py ./app/__init__.py
COPY app/providers ./app/providers
COPY johnny ./johnny

COPY meet-worker-entrypoint.sh /usr/local/bin/meet-worker-entrypoint.sh
RUN chmod +x /usr/local/bin/meet-worker-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/meet-worker-entrypoint.sh"]
CMD ["python", "-m", "johnny.meet_worker.selfcheck"]
